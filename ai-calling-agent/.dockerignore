# Ignore git files
.git
.gitignore
.gitattributes

# Ignore documentation (not needed in container)
*.md
README.md
QUICKSTART.md
TESTING.md
DEPLOYMENT.md
TROUBLESHOOTING.md

# Ignore environment files
.env
.env.example
.env.local
.env.*

# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db
desktop.ini

# Ignore logs
*.log
logs/

# Ignore temporary files
tmp/
temp/
*.tmp

# Ignore test files
tests/
test_*.py
*_test.py

# Ignore CI/CD files
.github/
.gitlab-ci.yml
.travis.yml

# Ignore Docker files (not needed inside container)
docker-compose*.yml
Dockerfile*
.dockerignore

# Ignore setup scripts (not needed inside container)
setup.ps1
setup.sh
ollama_setup.sh
health_check.sh
